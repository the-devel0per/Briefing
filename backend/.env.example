# Gemini API Key from Google AI Studio
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model (e.g. gemini-3.5-flash-lite)
GEMINI_MODEL=gemini-3.5-flash-lite

# Secret used to sign HMAC tokens for anonymous user sessions
SESSION_SECRET=local-dev-secret-change-me

# Ingestion concurrency for blazing fast feed fetching
INGEST_WORKERS=12
FEED_TIMEOUT_SECONDS=5

# User daily rewrite limit
REWRITE_USER_DAILY_LIMIT=100

# Frontend CORS origin
ALLOWED_ORIGINS=http://localhost:5173

# Daily cycle timezone
BRIEFING_TIMEZONE=UTC
